[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/share/gnome-shell/extensions/*/schemas/*gschema.xml 
Target = usr/share/gnome-shell/extensions/*/schemas/*gschema.override 

[Action]
Description = Compiling Community GSettings XML schema files...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/manjaro-extensions
