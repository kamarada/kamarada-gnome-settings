_inst_dir() {
	install -d $pkgdir/etc
	cp -r $srcdir/$pkgbase/skel $pkgdir/etc

	install -d $pkgdir/usr/share/glib-2.0/schemas
	cp $srcdir/$pkgbase/schemas/99_manjaro-settings.gschema.override $pkgdir/usr/share/glib-2.0/schemas
}

_inst_dir-extension() {
	cd "$srcdir/$pkgbase"

	# add here extensions : for any extension repeat the follow schemas

	# Dash to Dock
	# https://github.com/micheleg/dash-to-dock/issues/1475#issuecomment-880138403
	# Don't install this. Otherwise it needs to be precompiled
	#install -Dm644 schemas/10_dash-to-dock.gschema.override -t ${pkgdir}/usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com/schemas/

	# Material Shell
	install -Dm644 schemas/10_material-shell.gschema.override -t ${pkgdir}/usr/share/gnome-shell/extensions/material-shell@papyelgringo/schemas/

	# Pop Shell
	install -Dm644 schemas/10_pop-shell.gschema.override -t ${pkgdir}/usr/share/gnome-shell/extensions/pop-shell@system76.com/schemas/

	install -Dm755 scripts/apply-tiling-settings -t ${pkgdir}/usr/bin/
	install -Dm644 schemas/{appfolder-settings,etcetera.gschema.override} -t ${pkgdir}/usr/share/gnome-shell/
}

pkgver() {
	date +%Y%m%d
}

package_manjaro-gnome-settings() {
	pkgdesc="Manjaro Linux Gnome settings"

	optdepends=('manjaro-gdm-theme: Branding theme for Gdm'
				'lighter-gnome: some gnome-settings-daemon components'
				'papirus-maia-icon-theme: default icons set')
	provides=("manjaro-desktop-settings")
	conflicts=("manjaro-gnome-settings-$_branch" "manjaro-gnome-settings-$_oldbranch")
	replaces=("manjaro-gnome-settings-$_branch")

	_inst_dir

	cd "$srcdir/$pkgbase"
	install -Dm644 ${srcdir}/manjaro-gnome-messages.hook -t ${pkgdir}/usr/share/libalpm/hooks/
	install -Dm755 ${srcdir}/manjaro-gnome-messages.script ${pkgdir}/usr/share/libalpm/scripts/manjaro-gnome-messages
	install -Dm644 colors/Adwaita-maia-dark.conf -t ${pkgdir}/usr/share/qt5ct/colors/
	install -Dm644 colors/Adwaita-maia.conf -t ${pkgdir}/usr/share/qt5ct/colors/
}


package_manjaro-gnome-extension-settings() {
	pkgdesc="Manjaro Linux Gnome extensions settings"
	optdepends=("manjaro-gnome-settings-$_branch")
	conflicts=("manjaro-gnome-extension-settings-$_branch")
	replaces=("manjaro-gnome-extension-settings-$_branch")

	_inst_dir-extension

#	install -Dm644 ${srcdir}/manjaro-extensions.hook -t ${pkgdir}/usr/share/libalpm/hooks/
#	install -Dm755 ${srcdir}/manjaro-extensions.script ${pkgdir}/usr/share/libalpm/scripts/manjaro-extensions
}

package_manjaro-gdm-branding() {
	pkgdesc="Manjaro GDM branding"
	depends=('gnome-shell' 'dconf')

	cd "$srcdir/$pkgbase"
	install -Dm644 schemas/gdm -t ${pkgdir}/etc/dconf/profile/
	install -Dm644 schemas/10_manjaro-gdm-branding -t ${pkgdir}/etc/dconf/db/gdm.d/

	install -Dm644 ${srcdir}/logo/logo_text_white_48px.png -t ${pkgdir}/usr/share/icons/manjaro/maia/
	install -Dm644 ${srcdir}/manjaro-gdm-branding-install.hook -t ${pkgdir}/usr/share/libalpm/hooks/
	install -Dm644 ${srcdir}/manjaro-gdm-branding-remove.hook -t ${pkgdir}/usr/share/libalpm/hooks/
}

