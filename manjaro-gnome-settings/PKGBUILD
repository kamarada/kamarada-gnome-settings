_inst_dir(){
	install -d $pkgdir/etc
	cp -r $srcdir/$pkgbase/skel $pkgdir/etc

	install -d $pkgdir/usr/share/glib-2.0/schemas
	cp $srcdir/$pkgbase/schemas/99_manjaro-settings.gschema.override $pkgdir/usr/share/glib-2.0/schemas
}

_inst_dir-extension(){

#add here extensions : for any extension repeat the follow schemas

	install -d $pkgdir/usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com/schemas
	cp $srcdir/$pkgbase/schemas/10_dash-to-dock.gschema.override $pkgdir/usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com/schemas

	install -d $pkgdir/usr/share/gnome-shell/extensions/material-shell@papyelgringo/schemas
	cp $srcdir/$pkgbase/schemas/10_material-shell.gschema.override $pkgdir/usr/share/gnome-shell/extensions/material-shell@papyelgringo/schemas

	install -d $pkgdir/usr/share/gnome-shell/extensions/pop-shell@system76.com/schemas
	cp $srcdir/$pkgbase/schemas/10_pop-shell.gschema.override $pkgdir/usr/share/gnome-shell/extensions/pop-shell@system76.com/schemas

	install -d $pkgdir/usr/bin
	install -Dm755 $srcdir/$pkgbase/scripts/apply-tiling-settings $pkgdir/usr/bin/apply-tiling-settings
	cp $srcdir/$pkgbase/schemas/appfolder-settings $pkgdir/usr/share/gnome-shell/app-folder-settings
}

pkgver() {
    date +%Y%m%d
}

package_manjaro-gnome-settings() {
pkgdesc="Manjaro Linux Gnome settings"

optdepends=('manjaro-gdm-theme: Branding theme for Gdm'
			'lighter-gnome: some gnome-settings-daemon components'
			'papirus-maia-icon-theme: default icons set')
conflicts=("manjaro-gnome-settings" "manjaro-gnome-settings-$_branch" "manjaro-gnome-settings-$_oldbranch")
replaces=("manjaro-gnome-settings-$_branch")
provides=("manjaro-desktop-settings")

	_inst_dir

	install -Dm644 ${srcdir}/manjaro-gnome-messages.hook ${pkgdir}/usr/share/libalpm/hooks/manjaro-gnome-messages.hook
	install -Dm755 ${srcdir}/manjaro-gnome-messages.script ${pkgdir}/usr/share/libalpm/scripts/manjaro-gnome-messages

}


package_manjaro-gnome-extension-settings() {

pkgdesc="Manjaro Linux Gnome extensions settings"
optdepends=("manjaro-gnome-settings-$_branch")
conflicts=('manjaro-gnome-extension-settings' "manjaro-gnome-extension-settings-$_branch")
replaces=("manjaro-gnome-extension-settings-$_branch")

	_inst_dir-extension
	
	install -Dm644 ${srcdir}/manjaro-extensions.hook ${pkgdir}/usr/share/libalpm/hooks/manjaro-extensions.hook
	install -Dm755 ${srcdir}/manjaro-extensions.script ${pkgdir}/usr/share/libalpm/scripts/manjaro-extensions
}

package_manjaro-gdm-branding() {

pkgdesc="Manjaro GDM branding"
depends=('gnome-shell' 'dconf')

	install -Dm644 ${srcdir}/${pkgbase}/schemas/gdm ${pkgdir}/etc/dconf/profile/gdm
	install -Dm644 ${srcdir}/${pkgbase}/schemas/10_manjaro-gdm-branding ${pkgdir}/etc/dconf/db/gdm.d/10_manjaro-gdm-branding

	install -Dm644 ${srcdir}/logo/logo_text_white_48px.png ${pkgdir}/usr/share/icons/manjaro/maia/logo_text_white_48px.png
	install -Dm644 ${srcdir}/manjaro-gdm-branding-install.hook ${pkgdir}/usr/share/libalpm/hooks/manjaro-gdm-branding-install.hook
	install -Dm644 ${srcdir}/manjaro-gdm-branding-remove.hook ${pkgdir}/usr/share/libalpm/hooks/manjaro-gdm-branding-remove.hook

}

