_branch=gnome-next
_oldbranch=19.0
pkgname=("$pkgbase" "manjaro-gnome-extension-settings" 'manjaro-gdm-branding')
#          'manjaro-gnome-minimal-settings')
pkgver=20210515
pkgrel=1
arch=('any')
url="https://gitlab.manjaro.org/profiles-and-settings/manjaro-gnome-settings"
license=('GPL')
source=("manjaro-gnome-settings::git+$url.git#branch=$_branch"
		'logo::git+https://gitlab.manjaro.org/artwork/branding/logo.git'
		'manjaro-gnome-messages.hook'
		'manjaro-gnome-messages.script'
		'manjaro-extensions.hook'
		'manjaro-gdm-branding-install.hook'
		'manjaro-gdm-branding-remove.hook'
		'manjaro-extensions.hook'
		'manjaro-extensions.script'
)
makedepends=('git')
sha256sums=('SKIP'
