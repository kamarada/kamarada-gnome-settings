#!/bin/bash

#override extensions settings

ext_path=/usr/share/gnome-shell/extensions

for i in $(ls $ext_path/); do
	if [[ -d "$ext_path/$i/schemas" ]]; then
		if [[ -f $ext_path/$i/schemas/*.xml ]] || [[ $ext_path/$i/schemas/*.override ]]; then
			glib-compile-schemas $ext_path/$i/schemas
		fi
	fi
done